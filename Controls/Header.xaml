<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademicTracker.Controls.AppHeader">

    <Grid BackgroundColor="{StaticResource WguLightBlue}"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="12"
          Padding="20,14">

        <Image Grid.Column="0"
               Source="logo.png"
               HeightRequest="36"
               Aspect="AspectFit"
               HorizontalOptions="Start"
               VerticalOptions="Center"
               SemanticProperties.Description="App logo" />

        <Label Grid.Column="1"
               Text="Student Name"
               TextColor="{StaticResource WguMidnight}"
               FontSize="16"
               HorizontalOptions="End"
               VerticalOptions="Center" />
    </Grid>
</ContentView>