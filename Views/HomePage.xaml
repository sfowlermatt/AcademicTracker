<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AcademicTracker.Models"
             xmlns:vm="clr-namespace:AcademicTracker.ViewModels"
             x:Class="AcademicTracker.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="20,10" RowSpacing="20">

       <Button Grid.Row="0"
               Text="Add Term"
               HorizontalOptions="End"
               Command="{Binding AddTermCommand}" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Terms}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="No terms yet"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Term">
                    <Border BackgroundColor="#EAEAEA"
                            Stroke="#757575"
                            StrokeThickness="2"
                            Padding="20,16"
                            HeightRequest="130">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnTermTapped"/>
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontSize="22"
                                   TextColor="Black"/>

                            <Label Grid.Row="0" Grid.Column="1"
                                   FontSize="14"
                                   TextColor="Black"
                                   VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:MMM d, yyyy} - {1:MMM d, yyyy}">
                                        <Binding Path="StartDate" />
                                        <Binding Path="EndDate" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <Button Grid.Row="1" Grid.Column="1"
                                    Text="Edit"
                                    HeightRequest="34"
                                    Padding="16,0"
                                    CornerRadius="17"
                                    BackgroundColor="Transparent"
                                    TextColor="Black"
                                    BorderColor="#757575"
                                    BorderWidth="2"
                                    VerticalOptions="End"
                                    Clicked="OnEditTermClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>