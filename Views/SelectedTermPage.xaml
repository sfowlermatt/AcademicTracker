<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AcademicTracker.Models"
             xmlns:vm="clr-namespace:AcademicTracker.ViewModels"
             x:Class="AcademicTracker.Views.SelectedTermPage"
             x:DataType="vm:SelectedTermViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,10" RowSpacing="12">

        <HorizontalStackLayout Grid.Row="0" Spacing="12">
            <Button Text="Back" Command="{Binding GoBackCommand}" />
        </HorizontalStackLayout>

        <Button Grid.Row="1"
                Text="Edit"
                HorizontalOptions="End"
                HeightRequest="34"
                Padding="16,0"
                CornerRadius="17"
                BackgroundColor="Transparent"
                TextColor="Black"
                BorderColor="#757575"
                BorderWidth="2"
                Command="{Binding EditTermCommand}" />

        <Border Grid.Row="2"
                BackgroundColor="#EAEAEA"
                Stroke="#757575"
                StrokeThickness="2"
                Padding="20,16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" RowSpacing="16">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="{Binding Term.Title}"
                       FontSize="22"
                       TextColor="Black" />

                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding DateRange}"
                       FontSize="14"
                       TextColor="Black"
                       VerticalOptions="Center" />

                <CollectionView Grid.Row="1" Grid.ColumnSpan="2"
                                ItemsSource="{Binding Courses}"
                                SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label Text="No courses yet"
                               HorizontalOptions="Center"
                               TextColor="Black" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Course">
                            <Border BackgroundColor="#EAEAEA"
                                    Stroke="#757575"
                                    StrokeThickness="2"
                                    Padding="12"
                                    HeightRequest="56">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCourseTapped" />
                                </Border.GestureRecognizers>

                                <Label Text="{Binding Name}"
                                       FontSize="20"
                                       TextColor="Black"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>